# GenZ-LIO RViz configuration.
#
# Fixed Frame is world, not camera_init. The odometry frame camera_init is
# whatever attitude the platform started at; the gravity alignment lives in the
# world -> camera_init transform the node publishes once the IMU has settled.
# Viewing in camera_init renders the map tilted by that initial attitude.
#
# The map display is /cloud_registered with a very long decay time, so the
# registered scans accumulate instead of replacing each other.
Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Mapping1
        - /Mapping1/Map1
        - /Hybrid metric1
        - /Trajectory1
      Splitter Ratio: 0.550000011920929
    Tree Height: 513
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.15000000596046448
      Cell Size: 5
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
