# ROS1-equivalent displays and camera; full map accumulation retained.
Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Mapping1
    - /Mapping1/Map1
    - /Hybrid metric1
    - /Trajectory1
    Splitter Ratio: 0.550000011920929
  Tree Height: 513
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
