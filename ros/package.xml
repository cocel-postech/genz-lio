<?xml version="1.0"?>
<package format="3">
  <name>genz_lio</name>
  <version>0.1.0</version>
  <description>
    GenZ-LIO: generalizable LiDAR-inertial odometry that adapts to changes in
    spatial scale across confined and open environments.
  </description>

  <maintainer email="daehanlee@postech.ac.kr">GenZ-LIO maintainers</maintainer>
  <license>GPL-2.0</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <exec_depend condition="$ROS_VERSION == 1">rospy</exec_depend>
  <depend condition="$ROS_VERSION == 1">roslib</depend>
  <depend condition="$ROS_VERSION == 1">tf</depend>
  <depend condition="$ROS_VERSION == 1">tf2_ros</depend>
  <depend condition="$ROS_VERSION == 1">pcl_ros</depend>
  <depend condition="$ROS_VERSION == 1">pcl_conversions</depend>

  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <exec_depend condition="$ROS_VERSION == 2">rclpy</exec_depend>
  <depend condition="$ROS_VERSION == 2">tf2_ros</depend>
  <depend condition="$ROS_VERSION == 2">pcl_conversions</depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
